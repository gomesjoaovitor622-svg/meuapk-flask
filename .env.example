# Variáveis de ambiente — copie para `.env` e ajuste os valores.
# NUNCA comite o arquivo `.env`.

# Obrigatório. Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria-de-32-bytes

# Ambiente: dev | test | prod
FLASK_ENV=dev

# Banco de dados
DATABASE_URL=sqlite:///meuapk.db

# Sessão
SESSION_COOKIE_SECURE=false
SESSION_HORAS=8

# Limite de corpo das requisições (bytes)
MAX_CONTENT_LENGTH=1048576

# Usuários de demonstração criados por `python -m scripts.seed`
ADMIN_USUARIO=joao
ADMIN_SENHA=
ALUNO_SENHA=
VISITANTE_SENHA=
